# Configurazione del sensore Hyperwave. Contiene il token: lasciare i permessi a 600.
# Dopo averla compilata:  systemctl enable --now hyperwave-sensor

# Indirizzo dell'hub (meglio HTTPS se passa da una rete non fidata)
HW_HUB_URL=https://hub.esempio.lan:3121

# Token creato dalla pagina Sensori o con  hw-hub sensor-add
HW_SENSOR_TOKEN=

# Interfaccia collegata alla porta SPAN o al TAP
HW_SENSOR_IFACE=eth1

# Spazio massimo della coda su disco quando l'hub non risponde (MB)
#HW_SPOOL_MAX_MB=2048
